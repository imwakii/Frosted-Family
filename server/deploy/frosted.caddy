# Template: `setup.sh caddy` fills in __FROSTED_API_HOST__ from FROSTED_API_HOST, installs the result to
# /etc/caddy/sites/frosted.caddy and adds the import line to the Caddyfile. Caddy gets the certificate by HTTP challenge.
# The site reaches this through a Vercel rewrite, so players only ever see the Vercel URL.
__FROSTED_API_HOST__ {
	# The API's largest honest body is a plan, well under this. A huge one would run it past its memory limit.
	request_body {
		max_size 1MB
	}
	encode gzip
	header {
		-Server
		# Only where the API set none: sign-in and plan answers say no-store and must keep it.
		?Cache-Control "public, max-age=30"
	}
	reverse_proxy 127.0.0.1:8090
}
